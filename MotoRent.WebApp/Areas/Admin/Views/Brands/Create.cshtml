@model CreateBrandDto
@{
    ViewData["Title"] = "Thêm hãng xe";
}

<partial name="_AdminNav" />

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <h1 class="h4 mb-3">Thêm hãng xe</h1>
        <form asp-action="Create" method="post" class="card card-body">
            <partial name="_BrandForm" model="Model" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Lưu</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Huỷ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
