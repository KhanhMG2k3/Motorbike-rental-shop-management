@model List<BrandDto>
@{
    ViewData["Title"] = "Quản lý hãng xe";
}

<partial name="_AdminNav" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Hãng xe</h1>
    <a asp-action="Create" class="btn btn-primary">+ Thêm hãng</a>
</div>

<partial name="_StatusMessage" />

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Tên hãng</th>
                <th>Quốc gia</th>
                <th class="text-center">Số xe</th>
                <th>Trạng thái</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var brand in Model)
            {
                <tr class="@(brand.IsActive ? "" : "text-muted")">
                    <td class="fw-semibold">@brand.BrandName</td>
                    <td>@(brand.Country ?? "—")</td>
                    <td class="text-center">@brand.MotorbikeCount</td>
                    <td>
                        @if (brand.IsActive) { <span class="badge bg-success">Hoạt động</span> }
                        else { <span class="badge bg-secondary">Ngừng</span> }
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@brand.BrandId" class="btn btn-sm btn-outline-primary">Sửa</a>
                        @if (brand.IsActive)
                        {
                            <form asp-action="Deactivate" asp-route-id="@brand.BrandId" method="post" class="d-inline"
                                  onsubmit="return confirm('Ngừng hoạt động hãng @brand.BrandName?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Ngừng</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted">Chưa có hãng xe.</td></tr>
            }
        </tbody>
    </table>
</div>
