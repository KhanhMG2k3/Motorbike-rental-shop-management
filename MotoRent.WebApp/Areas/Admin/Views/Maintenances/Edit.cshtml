@model MaintenanceFormViewModel
@{
    ViewData["Title"] = "Sửa phiếu bảo dưỡng";
}

<partial name="_AdminNav" />

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="d-flex align-items-center gap-2 mb-3">
            <h1 class="h4 mb-0">Sửa phiếu bảo dưỡng #@Model.MaintenanceId</h1>
            @if (Model.Current != null)
            {
                <status-badge value="@Model.Current.Status" kind="maintenance" />
            }
        </div>
        <form asp-action="Edit" asp-route-id="@Model.MaintenanceId" method="post" class="card card-body">
            <partial name="_MaintenanceForm" model="Model" />
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
