@model PaymentListViewModel
@{
    ViewData["Title"] = "Quản lý thanh toán";
    var f = Model.Filter;
    var r = Model.Result;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    var routeValues = new Dictionary<string, string>();
    if (f.RentalId.HasValue) routeValues["rentalId"] = f.RentalId.Value.ToString();
    if (!string.IsNullOrEmpty(f.Type)) routeValues["type"] = f.Type;
    if (!string.IsNullOrEmpty(f.Method)) routeValues["method"] = f.Method;
    if (!string.IsNullOrEmpty(f.Status)) routeValues["status"] = f.Status;
    if (f.From.HasValue) routeValues["from"] = f.From.Value.ToString("yyyy-MM-dd");
    if (f.To.HasValue) routeValues["to"] = f.To.Value.ToString("yyyy-MM-dd");

    var pagination = new PaginationViewModel
    {
        Page = f.Page,
        TotalPages = Model.TotalPages,
        Controller = "Payments",
        Action = "Index",
        RouteValues = routeValues
    };
}

<partial name="_AdminNav" />

<div class="d-flex justify-content-between align-items-end mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h4 mb-0">Thanh toán</h1>
        <small class="text-muted">@r.TotalCount khoản phù hợp</small>
    </div>
</div>

<partial name="_StatusMessage" />
@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<!-- Tổng hợp (chỉ tính các khoản đã thanh toán, theo bộ lọc hiện tại) -->
<div class="row g-3 mb-3">
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Đã thu (cọc + tiền thuê + phạt)</div>
            <div class="fs-4 fw-bold text-success">@DisplayHelper.Money(r.TotalCollected)</div>
        </div></div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Đã hoàn trả khách</div>
            <div class="fs-4 fw-bold text-secondary">@DisplayHelper.Money(r.TotalRefunded)</div>
        </div></div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Doanh thu (tiền thuê + phạt)</div>
            <div class="fs-4 fw-bold text-primary">@DisplayHelper.Money(r.Revenue)</div>
        </div></div>
    </div>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div asp-validation-summary="All" class="text-danger small"></div>
    <div class="col-6 col-md-2">
        <select name="type" asp-items="PaymentListViewModel.TypeOptions()" class="form-select">
            <option value="">Mọi loại</option>
        </select>
    </div>
    <div class="col-6 col-md-2">
        <select name="method" asp-items="PaymentListViewModel.MethodOptions()" class="form-select">
            <option value="">Mọi phương thức</option>
        </select>
    </div>
    <div class="col-6 col-md-2">
        <select name="status" asp-items="PaymentListViewModel.StatusOptions()" class="form-select">
            <option value="">Mọi trạng thái</option>
        </select>
    </div>
    <div class="col-6 col-md-2">
        <input type="date" name="from" value="@f.From?.ToString("yyyy-MM-dd")" class="form-control" title="Từ ngày" />
    </div>
    <div class="col-6 col-md-2">
        <input type="date" name="to" value="@f.To?.ToString("yyyy-MM-dd")" class="form-control" title="Đến ngày" />
    </div>
    <div class="col-6 col-md-2 d-grid">
        <button type="submit" class="btn btn-outline-primary">Lọc</button>
    </div>
    @if (f.RentalId.HasValue)
    {
        <input type="hidden" name="rentalId" value="@f.RentalId" />
    }
</form>
@* Giữ giá trị đã chọn trong các ô select lọc *@
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const values = { type: '@f.Type', method: '@f.Method', status: '@f.Status' };
        for (const [name, value] of Object.entries(values)) {
            const el = document.querySelector(`select[name="${name}"]`);
            if (el) el.value = value;
        }
    });
</script>

@if (f.RentalId.HasValue)
{
    <div class="alert alert-info py-2">Đang xem thanh toán của đơn thuê #@f.RentalId. <a asp-action="Index">Xem tất cả</a></div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Đơn thuê</th>
                <th>Khách hàng</th>
                <th>Loại</th>
                <th>Phương thức</th>
                <th class="text-end">Số tiền</th>
                <th>Trạng thái</th>
                <th>Thời gian</th>
                <th>Chi tiết</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in r.Items)
            {
                <tr>
                    <td class="text-nowrap">
                        <a asp-controller="Rentals" asp-action="Details" asp-route-id="@p.RentalId" class="text-decoration-none fw-semibold">@p.RentalCode</a>
                    </td>
                    <td>@p.CustomerName</td>
                    <td>
                        @DisplayHelper.PaymentTypeText(p.PaymentType)
                    </td>
                    <td class="small">@DisplayHelper.PaymentMethodText(p.PaymentMethod)</td>
                    <td class="text-end text-nowrap @(p.PaymentType == PaymentType.Refund ? "text-secondary" : "")">
                        @(p.PaymentType == PaymentType.Refund ? "−" : "")@DisplayHelper.Money(p.Amount)
                    </td>
                    <td><span class="badge @DisplayHelper.PaymentStatusBadge(p.Status)">@DisplayHelper.PaymentStatusText(p.Status)</span></td>
                    <td class="small text-nowrap">@DisplayHelper.DateTimeText(p.PaidAt ?? p.CreatedAt)</td>
                    <td class="small">
                        @if (!string.IsNullOrEmpty(p.TransactionRef)) { <div>Mã GD: <code>@p.TransactionRef</code></div> }
                        @if (!string.IsNullOrEmpty(p.ProcessedByName)) { <div class="text-muted">Xử lý: @p.ProcessedByName</div> }
                        @if (!string.IsNullOrEmpty(p.Note)) { <div class="text-muted">@p.Note</div> }
                    </td>
                    <td class="text-end text-nowrap">
                        @if (p.Status == PaymentStatus.Pending)
                        {
                            <form asp-action="Confirm" asp-route-id="@p.PaymentId" method="post" class="d-inline-flex gap-1">
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <input type="text" name="transactionRef" maxlength="100" class="form-control form-control-sm" style="width:120px" placeholder="Mã giao dịch" />
                                <button type="submit" class="btn btn-sm btn-success">Xác nhận</button>
                            </form>
                            <form asp-action="Cancel" asp-route-id="@p.PaymentId" method="post" class="d-inline"
                                  onsubmit="var r = prompt('Lý do huỷ khoản thanh toán:'); if (!r || r.trim().length < 3) { alert('Vui lòng nhập lý do (ít nhất 3 ký tự).'); return false; } this.reason.value = r.trim(); return true;">
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <input type="hidden" name="reason" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Huỷ</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!r.Items.Any() && Model.ErrorMessage == null)
            {
                <tr><td colspan="9" class="text-center text-muted">Không có khoản thanh toán nào.</td></tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="pagination" />
