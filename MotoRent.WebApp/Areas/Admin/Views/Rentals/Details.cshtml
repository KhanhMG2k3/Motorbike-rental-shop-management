@model StaffRentalDetailViewModel
@{
    var r = Model.Rental;
    ViewData["Title"] = $"Xử lý đơn {r.RentalCode}";
    bool isStaff = User.IsInRole(AppRoles.Staff);
    var finalTotal = r.TotalAmount ?? (r.SubTotal - r.DiscountAmount + r.LateFee + r.DamageFee);

    int stepIndex = r.Status switch
    {
        RentalStatus.Pending => 1,
        RentalStatus.Confirmed => 2,
        RentalStatus.Renting => 3,
        RentalStatus.Completed => 4,
        _ => 0
    };
    string StepClass(int s) => stepIndex == 0 ? "" : (s < stepIndex || stepIndex == 4 ? "done" : (s == stepIndex ? "current" : ""));
}

<partial name="_AdminNav" />

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Đơn thuê xe</a></li>
        <li class="breadcrumb-item active" aria-current="page">@r.RentalCode</li>
    </ol>
</nav>

<partial name="_StatusMessage" />

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h1 class="h4 mb-0">Đơn thuê @r.RentalCode</h1>
            <status-badge value="@r.Status" kind="rental" />
        </div>
        <small class="text-muted">
            Tạo lúc @DisplayHelper.DateTimeText(r.CreatedAt) · Chi nhánh: <strong>@r.BranchName</strong>
            @if (!string.IsNullOrWhiteSpace(r.StaffName))
            {
                <span> · Phụ trách: <strong>@r.StaffName</strong></span>
            }
        </small>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (isStaff && r.Status == RentalStatus.Confirmed)
        {
            <a asp-action="Pickup" asp-route-id="@r.RentalId" class="btn btn-info text-dark fw-semibold">
                🔑 Chuyển sang Biên bản bàn giao xe →
            </a>
        }
        @if (isStaff && r.Status == RentalStatus.Renting)
        {
            <a asp-action="Return" asp-route-id="@r.RentalId" class="btn btn-primary fw-semibold">
                🏁 Nhận trả xe & Quyết toán →
            </a>
        }
        @if (r.Status == RentalStatus.Completed)
        {
            <a asp-action="Invoice" asp-route-id="@r.RentalId" class="btn btn-success fw-semibold">
                🖨️ Xem & In hoá đơn quyết toán
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">← Danh sách</a>
    </div>
</div>

@if (!isStaff)
{
    <div class="alert alert-info py-2 small">
        Bạn đang đăng nhập với vai trò <strong>Quản trị (Admin)</strong> (chế độ xem giám sát). Các thao tác duyệt cọc, bàn giao xe và quyết toán tại quầy được thực hiện bởi tài khoản <strong>Nhân viên (Staff)</strong>.
    </div>
}

<!-- Thanh tiến trình -->
@if (r.Status == RentalStatus.Cancelled)
{
    <div class="alert alert-secondary mb-4">
        <strong>❌ Đơn thuê đã bị huỷ.</strong>
        @if (!string.IsNullOrWhiteSpace(r.CancelReason))
        {
            <div>Lý do huỷ: <em>@r.CancelReason</em></div>
        }
    </div>
}
else
{
    <div class="rental-stepper mb-4 flex-column flex-md-row">
        <div class="rental-step @StepClass(1)">1. Chờ duyệt (Pending)</div>
        <div class="rental-step @StepClass(2)">2. Đã xác nhận & Thu cọc</div>
        <div class="rental-step @StepClass(3)">3. Đang thuê xe (Renting)</div>
        <div class="rental-step @StepClass(4)">4. Hoàn thành & Quyết toán</div>
    </div>
}

<div class="row g-4">
    <!-- Cột trái: Hồ sơ khách hàng, Danh sách xe & Lịch sử thanh toán -->
    <div class="col-12 col-lg-8">
        <!-- Hồ sơ khách hàng & Kiểm tra giấy tờ BR4 -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <span class="fw-bold">Thông tin khách hàng & Giấy tờ tuỳ thân</span>
                @if (Model.HasValidDocuments)
                {
                    <span class="badge bg-success">✓ Đủ CCCD & GPLX để bàn giao xe</span>
                }
                else
                {
                    <span class="badge bg-danger">⚠️ Thiếu CCCD hoặc GPLX (BR4)</span>
                }
            </div>
            <div class="card-body">
                <div class="row g-3 small">
                    <div class="col-sm-6 col-md-4">
                        <span class="text-muted d-block">Họ và tên khách:</span>
                        <strong class="fs-6">@r.CustomerName</strong>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <span class="text-muted d-block">Số điện thoại:</span>
                        <strong>@(r.CustomerPhone ?? "—")</strong>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <span class="text-muted d-block">Email:</span>
                        <span>@r.CustomerEmail</span>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted d-block">Số CCCD / CMND:</span>
                        @if (!string.IsNullOrWhiteSpace(r.CustomerIdentityNumber))
                        {
                            <span class="fw-semibold text-dark">@r.CustomerIdentityNumber</span>
                        }
                        else
                        {
                            <span class="text-danger fw-semibold">Chưa cập nhật</span>
                        }
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted d-block">Số Giấy phép lái xe (GPLX):</span>
                        @if (!string.IsNullOrWhiteSpace(r.CustomerDriverLicense))
                        {
                            <span class="fw-semibold text-dark">@r.CustomerDriverLicense</span>
                        }
                        else
                        {
                            <span class="text-danger fw-semibold">Chưa cập nhật</span>
                        }
                    </div>
                </div>
                @if (!Model.HasValidDocuments && (r.Status == RentalStatus.Pending || r.Status == RentalStatus.Confirmed))
                {
                    <div class="alert alert-warning mb-0 mt-3 py-2 small">
                        <strong>Lưu ý quy tắc BR4:</strong> Khách vẫn có thể được duyệt cọc giữ xe, nhưng trước khi <strong>Bàn giao xe</strong> khách bắt buộc phải cập nhật đầy đủ số CCCD và GPLX trong mục <em>Hồ sơ cá nhân</em>.
                    </div>
                }
            </div>
        </div>

        <!-- Danh sách xe trong đơn -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white fw-bold py-3">Danh sách xe thuê (@r.Details.Count xe)</div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Xe máy</th>
                            <th>Đơn giá × Ngày</th>
                            <th>Số km (Giao → Trả)</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in r.Details)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@(d.ImageUrl ?? Url.Content("~/images/no-image.svg"))"
                                             onerror="this.onerror=null;this.src='@Url.Content("~/images/no-image.svg")';"
                                             style="width:56px;height:40px;object-fit:cover;" class="rounded border" alt="@d.ModelName" />
                                        <div>
                                            <div class="fw-semibold">@d.ModelName</div>
                                            <div class="small text-muted">@d.LicensePlate · Cọc @DisplayHelper.Money(d.DepositAmount)</div>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(d.PickupCondition) || !string.IsNullOrWhiteSpace(d.ReturnCondition))
                                    {
                                        <div class="small text-muted mt-1">
                                            @if (!string.IsNullOrWhiteSpace(d.PickupCondition))
                                            {
                                                <div><strong>Lúc giao:</strong> @d.PickupCondition</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(d.ReturnCondition))
                                            {
                                                <div><strong>Lúc trả:</strong> @d.ReturnCondition</div>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="small text-nowrap">@DisplayHelper.Money(d.PricePerDay) × @d.NumberOfDays ngày</td>
                                <td class="small text-nowrap">
                                    @(d.PickupOdometer.HasValue ? $"{d.PickupOdometer:N0} km" : "—")
                                    →
                                    @(d.ReturnOdometer.HasValue ? $"{d.ReturnOdometer:N0} km" : "—")
                                    @if (d.PickupOdometer.HasValue && d.ReturnOdometer.HasValue)
                                    {
                                        <div class="text-muted">(+@(d.ReturnOdometer.Value - d.PickupOdometer.Value) km)</div>
                                    }
                                </td>
                                <td class="text-end fw-semibold text-nowrap">
                                    @DisplayHelper.Money(d.LineTotal ?? (d.PricePerDay * d.NumberOfDays))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Lịch sử giao dịch thanh toán -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white fw-bold py-3">Nhật ký thanh toán & Hoàn cọc</div>
            <div class="card-body p-0">
                @if (!r.Payments.Any())
                {
                    <div class="p-3 text-muted small">Chưa có giao dịch thanh toán nào được ghi nhận cho đơn này.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Loại giao dịch</th>
                                    <th>Phương thức</th>
                                    <th>Thời gian</th>
                                    <th>Mã GD / Ghi chú</th>
                                    <th class="text-end pe-3">Số tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in r.Payments)
                                {
                                    <tr>
                                        <td class="ps-3 fw-semibold">@DisplayHelper.PaymentTypeText(p.PaymentType)</td>
                                        <td class="small">@DisplayHelper.PaymentMethodText(p.PaymentMethod)</td>
                                        <td class="small text-nowrap">@DisplayHelper.DateTimeText(p.PaidAt)</td>
                                        <td class="small text-muted">
                                            @if (!string.IsNullOrWhiteSpace(p.TransactionRef))
                                            {
                                                <code class="me-1">@p.TransactionRef</code>
                                            }
                                            @(p.Note ?? "—")
                                        </td>
                                        <td class="text-end pe-3 fw-semibold text-nowrap @(p.PaymentType == PaymentType.Refund ? "text-success" : "")">
                                            @(p.PaymentType == PaymentType.Refund ? "Hoàn " : "")@DisplayHelper.Money(p.Amount)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Cột phải: Thao tác Duyệt cọc, Tóm tắt chi phí & Huỷ đơn -->
    <div class="col-12 col-lg-4">
        <!-- 1. FORM DUYỆT ĐƠN & THU CỌC (Chỉ hiện cho Staff khi đơn đang Pending) -->
        @if (isStaff && r.Status == RentalStatus.Pending)
        {
            <div id="confirm-card" class="card border-warning shadow-sm mb-4">
                <div class="card-header bg-warning text-dark fw-bold py-3">
                    ✅ Duyệt đơn & Xác nhận tiền cọc
                </div>
                <div class="card-body">
                    <div class="alert alert-light border py-2 mb-3 small">
                        Số tiền đặt cọc cần thu:<br />
                        <strong class="fs-5 text-danger">@DisplayHelper.Money(r.DepositAmount)</strong>
                    </div>

                    <form asp-action="Confirm" asp-route-id="@r.RentalId" method="post"
                          onsubmit="return confirm('Xác nhận đã thu đủ cọc @DisplayHelper.Money(r.DepositAmount) và duyệt đơn @r.RentalCode?');">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <div class="mb-3">
                            <label asp-for="ConfirmForm.PaymentMethod" class="form-label small fw-semibold">Phương thức thu cọc <span class="text-danger">*</span></label>
                            <select asp-for="ConfirmForm.PaymentMethod" asp-items="AdminRentalListViewModel.PaymentMethodOptions()" class="form-select form-select-sm"></select>
                            <span asp-validation-for="ConfirmForm.PaymentMethod" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmForm.TransactionRef" class="form-label small fw-semibold">Mã giao dịch (nếu chuyển khoản / ví)</label>
                            <input asp-for="ConfirmForm.TransactionRef" class="form-control form-control-sm" placeholder="VD: FT2629912345..." />
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmForm.Note" class="form-label small fw-semibold">Ghi chú thu cọc</label>
                            <input asp-for="ConfirmForm.Note" class="form-control form-control-sm" placeholder="VD: Đã nhận đủ cọc tại quầy..." />
                        </div>

                        <button type="submit" class="btn btn-warning w-100 fw-bold">
                            Duyệt đơn & Ghi nhận cọc
                        </button>
                    </form>
                </div>
            </div>
        }

        <!-- 2. TÓM TẮT LỊCH TRÌNH & TÀI CHÍNH -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white fw-bold py-3">Lịch trình & Tổng hợp phí</div>
            <div class="card-body">
                <div class="mb-2 small">
                    <span class="text-muted d-block">Ngày giờ nhận xe:</span>
                    <strong>@DisplayHelper.DateTimeText(r.StartDate)</strong>
                </div>
                <div class="mb-2 small">
                    <span class="text-muted d-block">Ngày giờ hẹn trả:</span>
                    <strong>@DisplayHelper.DateTimeText(r.ExpectedReturnDate)</strong>
                </div>
                @if (r.ActualReturnDate.HasValue)
                {
                    <div class="mb-2 small">
                        <span class="text-muted d-block">Ngày giờ trả thực tế:</span>
                        <strong class="text-success">@DisplayHelper.DateTimeText(r.ActualReturnDate)</strong>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(r.Note))
                {
                    <div class="mb-2 small">
                        <span class="text-muted d-block">Ghi chú từ khách hàng:</span>
                        <span>@r.Note</span>
                    </div>
                }

                <hr />

                <div class="d-flex justify-content-between small mb-1">
                    <span class="text-muted">Tiền thuê gốc:</span>
                    <span>@DisplayHelper.Money(r.SubTotal)</span>
                </div>
                @if (r.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between small mb-1 text-success">
                        <span>Giảm giá:</span>
                        <span>-@DisplayHelper.Money(r.DiscountAmount)</span>
                    </div>
                }
                @if (r.LateFee > 0)
                {
                    <div class="d-flex justify-content-between small mb-1 text-danger">
                        <span>Phí trả trễ:</span>
                        <span>+@DisplayHelper.Money(r.LateFee)</span>
                    </div>
                }
                @if (r.DamageFee > 0)
                {
                    <div class="d-flex justify-content-between small mb-1 text-danger">
                        <span>Phí hư hỏng:</span>
                        <span>+@DisplayHelper.Money(r.DamageFee)</span>
                    </div>
                }
                <div class="d-flex justify-content-between fw-bold fs-5 text-primary border-top pt-2 mt-2">
                    <span>Tổng chi phí:</span>
                    <span>@DisplayHelper.Money(finalTotal)</span>
                </div>
                <div class="d-flex justify-content-between small text-muted mt-1">
                    <span>Tiền đặt cọc:</span>
                    <strong>@DisplayHelper.Money(r.DepositAmount)</strong>
                </div>
            </div>
        </div>

        <!-- 3. FORM HUỶ ĐƠN (Chỉ hiện cho Staff khi Pending hoặc Confirmed) -->
        @if (isStaff && (r.Status == RentalStatus.Pending || r.Status == RentalStatus.Confirmed))
        {
            <div class="card border-danger border-opacity-50 shadow-sm">
                <div class="card-header bg-danger bg-opacity-10 text-danger fw-bold py-2">
                    Huỷ đơn thuê xe
                </div>
                <div class="card-body">
                    <form asp-action="Cancel" asp-route-id="@r.RentalId" method="post"
                          onsubmit="return confirm('Xác nhận huỷ đơn thuê @r.RentalCode?');">
                        <div class="mb-2">
                            <label asp-for="CancelForm.CancelReason" class="form-label small">Lý do huỷ <span class="text-danger">*</span></label>
                            <textarea asp-for="CancelForm.CancelReason" class="form-control form-control-sm" rows="2"
                                      placeholder="VD: Khách báo huỷ lịch / Không liên hệ được khách..." required minlength="3"></textarea>
                            <span asp-validation-for="CancelForm.CancelReason" class="text-danger small"></span>
                        </div>
                        @if (r.Status == RentalStatus.Confirmed && r.DepositAmount > 0)
                        {
                            <div class="mb-2">
                                <label asp-for="CancelForm.RefundMethod" class="form-label small">Phương thức hoàn cọc (@DisplayHelper.Money(r.DepositAmount))</label>
                                <select asp-for="CancelForm.RefundMethod" asp-items="AdminRentalListViewModel.PaymentMethodOptions()" class="form-select form-select-sm"></select>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="CancelForm.RefundMethod" value="Cash" />
                        }
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100 mt-1">Xác nhận huỷ đơn</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}