@model CreateStaffDto
@{
    ViewData["Title"] = "Tạo tài khoản nhân viên";
}

<partial name="_AdminNav" />

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-7">
        <h1 class="h4 mb-3">Tạo tài khoản nhân viên (Staff)</h1>
        <form asp-action="CreateStaff" method="post" class="card card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label">Họ và tên <span class="text-danger">*</span></label>
                <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label">Email đăng nhập <span class="text-danger">*</span></label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="staff@motorent.vn" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Password" class="form-label">Mật khẩu ban đầu <span class="text-danger">*</span></label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Tối thiểu 6 ký tự" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Phone" class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                    <input asp-for="Phone" class="form-control" placeholder="0901234567" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="BranchId" class="form-label">Chi nhánh làm việc <span class="text-danger">*</span></label>
                    <select asp-for="BranchId" class="form-select" asp-items="ViewBag.Branches">
                        <option value="">-- Chọn chi nhánh --</option>
                    </select>
                    <span asp-validation-for="BranchId" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DateOfBirth" class="form-label">Ngày sinh (đủ 18 tuổi)</label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="IdentityNumber" class="form-label">Số CCCD (12 số)</label>
                    <input asp-for="IdentityNumber" class="form-control" maxlength="12" placeholder="079..." />
                    <span asp-validation-for="IdentityNumber" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DriverLicenseNumber" class="form-label">Số giấy phép lái xe</label>
                    <input asp-for="DriverLicenseNumber" class="form-control" placeholder="Số GPLX (nếu có)" />
                    <span asp-validation-for="DriverLicenseNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Address" class="form-label">Địa chỉ</label>
                    <input asp-for="Address" class="form-control" placeholder="Địa chỉ cư trú" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-2">
                <button type="submit" class="btn btn-primary">Tạo nhân viên</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Huỷ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
