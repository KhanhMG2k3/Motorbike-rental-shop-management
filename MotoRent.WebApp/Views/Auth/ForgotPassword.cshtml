@model ForgotPasswordDto
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h2 class="h4 text-center fw-bold mb-3">Quên mật khẩu</h2>
                <p class="text-center text-muted small mb-4">Nhập email đã đăng ký, hệ thống sẽ gửi mã xác nhận 6 số để đặt lại mật khẩu.</p>

                <partial name="_StatusMessage" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <form asp-action="ForgotPassword" method="post">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mt-2">Gửi mã xác nhận</button>
                </form>

                <div class="text-center mt-3 small text-muted">
                    <a asp-action="Login" class="text-decoration-none fw-semibold">&larr; Quay lại đăng nhập</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
