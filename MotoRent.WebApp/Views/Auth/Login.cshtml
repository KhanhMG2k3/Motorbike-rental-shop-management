@model LoginDto
@{
    ViewData["Title"] = "Đăng nhập";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h2 class="h4 text-center fw-bold mb-3">Đăng nhập MotoRent</h2>
                <p class="text-center text-muted small mb-4">Đăng nhập tài khoản để đặt thuê xe máy và quản lý đơn hàng</p>

                <partial name="_StatusMessage" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <form asp-action="Login" asp-route-returnUrl="@returnUrl" method="post">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Mật khẩu</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mt-2">Đăng nhập</button>
                </form>

                <div class="text-center mt-3 small text-muted">
                    Chưa có tài khoản? <a asp-action="Register" class="text-decoration-none fw-semibold">Đăng ký ngay</a>
                </div>

                <hr class="my-3" />
                <div class="small text-muted bg-light p-2 rounded">
                    <strong>Tài khoản demo:</strong><br />
                    • Admin: <code>admin@motorent.vn</code> / <code>123456</code><br />
                    • Staff: <code>staff1@motorent.vn</code> / <code>123456</code><br />
                    • Customer: <code>customer1@example.com</code> / <code>123456</code>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
