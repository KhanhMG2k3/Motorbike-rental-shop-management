@model MotorbikeListViewModel
@{
    ViewData["Title"] = "Thuê xe máy";
    var f = Model.Filter;

    // Giữ bộ lọc khi chuyển trang
    var routeValues = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(f.Keyword)) routeValues["keyword"] = f.Keyword;
    if (f.BrandId.HasValue) routeValues["brandId"] = f.BrandId.Value.ToString();
    if (f.CategoryId.HasValue) routeValues["categoryId"] = f.CategoryId.Value.ToString();
    if (f.MinPrice.HasValue) routeValues["minPrice"] = f.MinPrice.Value.ToString("0");
    if (f.MaxPrice.HasValue) routeValues["maxPrice"] = f.MaxPrice.Value.ToString("0");
    if (f.OnlyAvailable) routeValues["onlyAvailable"] = "true";
    routeValues["sort"] = f.Sort;

    var pagination = new PaginationViewModel
    {
        Page = f.Page,
        TotalPages = Model.TotalPages,
        Controller = "Motorbikes",
        Action = "Index",
        RouteValues = routeValues
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-end mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0">Thuê xe máy</h1>
        <p class="text-muted mb-0">Tìm thấy <strong>@Model.TotalCount</strong> xe phù hợp</p>
    </div>
</div>

@if (TempData["Error"] is string tempError)
{
    <div class="alert alert-danger">@tempError</div>
}
@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row g-4">
    <!-- Bộ lọc -->
    <aside class="col-12 col-lg-3">
        <form method="get" asp-controller="Motorbikes" asp-action="Index" class="card card-body">
            <div asp-validation-summary="All" class="text-danger small"></div>

            <div class="mb-3">
                <label asp-for="Filter.Keyword" class="form-label"></label>
                <input asp-for="Filter.Keyword" name="keyword" class="form-control" placeholder="Tên xe, hãng, biển số..." />
            </div>

            <div class="mb-3">
                <label asp-for="Filter.BrandId" class="form-label"></label>
                <select asp-for="Filter.BrandId" name="brandId" asp-items="Model.BrandOptions" class="form-select">
                    <option value="">Tất cả</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Filter.CategoryId" class="form-label"></label>
                <select asp-for="Filter.CategoryId" name="categoryId" asp-items="Model.CategoryOptions" class="form-select">
                    <option value="">Tất cả</option>
                </select>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label asp-for="Filter.MinPrice" class="form-label"></label>
                    <input asp-for="Filter.MinPrice" name="minPrice" type="number" min="0" step="10000" class="form-control" placeholder="0" />
                </div>
                <div class="col-6">
                    <label asp-for="Filter.MaxPrice" class="form-label"></label>
                    <input asp-for="Filter.MaxPrice" name="maxPrice" type="number" min="0" step="10000" class="form-control" placeholder="500000" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Filter.Sort" class="form-label"></label>
                <select asp-for="Filter.Sort" name="sort" asp-items="MotorbikeListViewModel.SortOptions" class="form-select"></select>
            </div>

            <div class="form-check mb-3">
                <input asp-for="Filter.OnlyAvailable" name="onlyAvailable" class="form-check-input" />
                <label asp-for="Filter.OnlyAvailable" class="form-check-label"></label>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">Tìm xe</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Xoá bộ lọc</a>
            </div>
        </form>
    </aside>

    <!-- Danh sách xe -->
    <section class="col-12 col-lg-9">
        @if (!Model.Items.Any() && Model.ErrorMessage == null)
        {
            <div class="alert alert-info">Không có xe nào phù hợp với bộ lọc.</div>
        }

        <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3">
            @foreach (var bike in Model.Items)
            {
                <div class="col">
                    <partial name="_MotorbikeCard" model="bike" />
                </div>
            }
        </div>

        <div class="mt-4">
            <partial name="_Pagination" model="pagination" />
        </div>
    </section>
</div>
