@model MyPaymentsViewModel
@{
    ViewData["Title"] = "Lịch sử thanh toán";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Rentals" asp-action="MyRentals">Đơn thuê của tôi</a></li>
        <li class="breadcrumb-item active" aria-current="page">Lịch sử thanh toán</li>
    </ol>
</nav>

<h1 class="h3 mb-3">Lịch sử thanh toán</h1>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Tổng đã thanh toán</div>
            <div class="fs-4 fw-bold text-primary">@DisplayHelper.Money(Model.TotalPaid)</div>
            <div class="small text-muted">Gồm tiền cọc, tiền thuê và phí phát sinh</div>
        </div></div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Đã được hoàn lại</div>
            <div class="fs-4 fw-bold text-success">@DisplayHelper.Money(Model.TotalRefunded)</div>
            <div class="small text-muted">Hoàn cọc khi trả xe hoặc huỷ đơn</div>
        </div></div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Khoản đang chờ xác nhận</div>
            <div class="fs-4 fw-bold @(Model.PendingCount > 0 ? "text-warning" : "text-secondary")">@Model.PendingCount</div>
            <div class="small text-muted">Nhân viên sẽ xác nhận sau khi nhận tiền</div>
        </div></div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Đơn thuê</th>
                <th>Loại</th>
                <th>Phương thức</th>
                <th class="text-end">Số tiền</th>
                <th>Trạng thái</th>
                <th>Thời gian</th>
                <th>Ghi chú</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Payments)
            {
                <tr>
                    <td class="text-nowrap">
                        <a asp-controller="Rentals" asp-action="Details" asp-route-id="@p.RentalId" class="text-decoration-none fw-semibold">@p.RentalCode</a>
                    </td>
                    <td>@DisplayHelper.PaymentTypeText(p.PaymentType)</td>
                    <td class="small">@DisplayHelper.PaymentMethodText(p.PaymentMethod)</td>
                    <td class="text-end text-nowrap @(p.PaymentType == PaymentType.Refund ? "text-success" : "")">
                        @(p.PaymentType == PaymentType.Refund ? "+" : "")@DisplayHelper.Money(p.Amount)
                    </td>
                    <td><span class="badge @DisplayHelper.PaymentStatusBadge(p.Status)">@DisplayHelper.PaymentStatusText(p.Status)</span></td>
                    <td class="small text-nowrap">@DisplayHelper.DateTimeText(p.PaidAt ?? p.CreatedAt)</td>
                    <td class="small text-muted">@p.Note</td>
                </tr>
            }
            @if (!Model.Payments.Any() && Model.ErrorMessage == null)
            {
                <tr><td colspan="7" class="text-center text-muted">Bạn chưa có giao dịch thanh toán nào.</td></tr>
            }
        </tbody>
    </table>
</div>
