@model MyRentalsViewModel
@{
    ViewData["Title"] = "Đơn thuê của tôi";
    var currentStatus = Model.StatusFilter ?? "";

    var tabs = new (string Label, string Value)[]
    {
        ("Tất cả", ""),
        ("Chờ duyệt", RentalStatus.Pending),
        ("Đã xác nhận", RentalStatus.Confirmed),
        ("Đang thuê", RentalStatus.Renting),
        ("Hoàn thành", RentalStatus.Completed),
        ("Đã huỷ", RentalStatus.Cancelled)
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0">Đơn thuê của tôi</h1>
        <p class="text-muted mb-0">Theo dõi trạng thái đơn đặt xe, lịch sử thuê và đánh giá chất lượng xe</p>
    </div>
    <a asp-controller="Motorbikes" asp-action="Index" class="btn btn-primary">+ Đặt thuê xe mới</a>
</div>

<partial name="_StatusMessage" />
@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<!-- Các tab lọc nhanh theo trạng thái -->
<ul class="nav nav-pills flex-nowrap overflow-auto mb-4 pb-1">
    @foreach (var tab in tabs)
    {
        var active = currentStatus == tab.Value ? "active" : "";
        var count = Model.CountByStatus(tab.Value);
        <li class="nav-item me-1">
            <a class="nav-link text-nowrap @active"
               asp-action="MyRentals"
               asp-route-status="@(string.IsNullOrEmpty(tab.Value) ? null : tab.Value)">
                @tab.Label <span class="badge bg-light text-dark ms-1">@count</span>
            </a>
        </li>
    }
</ul>

@if (!Model.FilteredRentals.Any() && Model.ErrorMessage == null)
{
    <div class="card card-body text-center py-5 border-0 shadow-sm">
        <p class="text-muted mb-3">Chưa có đơn thuê xe nào trong mục này.</p>
        <div>
            <a asp-controller="Motorbikes" asp-action="Index" class="btn btn-outline-primary">Khám phá xe đang sẵn sàng</a>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var r in Model.FilteredRentals)
        {
            var finalTotal = r.TotalAmount ?? (r.SubTotal - r.DiscountAmount + r.LateFee + r.DamageFee);
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="fw-bold text-primary fs-6">@r.RentalCode</span>
                        <span class="text-muted small">· Đặt lúc @DisplayHelper.DateTimeText(r.CreatedAt)</span>
                        <span class="text-muted small">· 📍 @r.BranchName</span>
                    </div>
                    <status-badge value="@r.Status" kind="rental" />
                </div>

                <div class="card-body">
                    <div class="row g-3 align-items-center">
                        <div class="col-12 col-md-7">
                            @foreach (var d in r.Details)
                            {
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <img src="@(d.ImageUrl ?? Url.Content("~/images/no-image.svg"))"
                                         onerror="this.onerror=null;this.src='@Url.Content("~/images/no-image.svg")';"
                                         alt="@d.ModelName"
                                         style="width:64px;height:48px;object-fit:cover;"
                                         class="rounded border" />
                                    <div>
                                        <div class="fw-semibold">@d.ModelName <span class="text-muted fw-normal">(@d.LicensePlate)</span></div>
                                        <div class="small text-muted">
                                            @DisplayHelper.Money(d.PricePerDay)/ngày × @d.NumberOfDays ngày = <strong>@DisplayHelper.Money(d.LineTotal ?? (d.PricePerDay * d.NumberOfDays))</strong>
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="small text-muted mt-2">
                                🗓️ Nhận xe: <strong>@DisplayHelper.DateTimeText(r.StartDate)</strong>
                                → Hẹn trả: <strong>@DisplayHelper.DateTimeText(r.ExpectedReturnDate)</strong>
                            </div>
                        </div>

                        <div class="col-12 col-md-5 text-md-end border-top border-md-0 pt-2 pt-md-0">
                            <div class="small text-muted">Tổng thanh toán</div>
                            <div class="fs-5 fw-bold text-primary">@DisplayHelper.Money(finalTotal)</div>
                            <div class="small text-muted mb-2">Tiền cọc: @DisplayHelper.Money(r.DepositAmount)</div>

                            <div class="d-flex justify-content-md-end gap-2 flex-wrap">
                                @if (r.Status == RentalStatus.Completed)
                                {
                                    <a asp-action="Details" asp-route-id="@r.RentalId" asp-fragment="reviews" class="btn btn-sm btn-warning fw-semibold">
                                        ⭐ Đánh giá xe
                                    </a>
                                }
                                <a asp-action="Details" asp-route-id="@r.RentalId" class="btn btn-sm btn-outline-primary">
                                    Chi tiết & Theo dõi →
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}